#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "restaurant-pos: your data stays in Docker volumes (restaurant-pos_pg_data, restaurant-pos_uploads_data, restaurant-pos_state) and your settings and generated passwords in /etc/restaurant-pos/restaurant-pos.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name restaurant-pos down -v ; sudo rm -rf /etc/restaurant-pos" >&2
fi
exit 0
